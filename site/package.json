{
  "name": "swoosh-effect-story",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build-data": "node scripts/build-data.mjs",
    "check-data": "node scripts/build-data.mjs --check",
    "check-numbers": "node scripts/check-rendered.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run build-data && npm run build-images && node scripts/build-share.mjs && SITE_SOURCE_ONLY=1 npm test && next build && npm run check-numbers && npm test",
    "preview": "node scripts/preview.mjs",
    "audit-ui": "node scripts/audit-ui.mjs",
    "build-images": "node scripts/build-images.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@observablehq/plot": "0.6.17",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.3",
    "jsdom": "30.1.1",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
